# Environment configuration for the Prime Central server.
# For LOCAL development: copy this file to ".env" and adjust values.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# In PRODUCTION (Render): set these in the dashboard / render.yaml, NOT in a
# committed file. ".env" is gitignored and must never be committed.

# Password for the Careers admin panel. REQUIRED in production — never ship
# the default. Use a long, random value.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Port the server listens on. Locally defaults to 3000.
# On Render this is provided automatically; leave it unset there.
PORT=3000

# Where job postings are stored.
# - Local dev: leave unset (falls back to the bundled data/jobs.json).
# - Production with a persistent disk: point to the mounted path so admin
#   edits survive restarts and deploys. On first boot the server seeds this
#   file from the repo's data/jobs.json automatically.
# JOBS_FILE=/data/jobs.json

# --- Email for Contact & Request-a-Quote forms ---------------------------
# The forms POST to the server, which emails the enquiry to MAIL_TO.
# If these are not set, the forms are disabled and return a clear error.
#
# Gmail example (recommended): enable 2-Step Verification on the Google
# account, then create an "App Password" (Google Account -> Security ->
# App passwords) and use that 16-char value as SMTP_PASS (NOT your normal
# Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where enquiries are delivered (your inbox). Defaults to SMTP_USER if unset.
MAIL_TO=your-inbox@example.com
# The visible "from" address. Defaults to SMTP_USER if unset.
MAIL_FROM=your-gmail-address@gmail.com
